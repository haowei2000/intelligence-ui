{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intelligence-ui:protocol:1.0:ui-document",
  "title": "Intelligence UI document candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "root"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Protocol version; this release supports 1.0."
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "root": {
      "$ref": "#/$defs/Component"
    },
    "datasets": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rows"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "maxProperties": 50,
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Component": {
      "oneOf": [
        {
          "$ref": "#/$defs/Stack"
        },
        {
          "$ref": "#/$defs/Grid"
        },
        {
          "$ref": "#/$defs/Card"
        },
        {
          "$ref": "#/$defs/Divider"
        },
        {
          "$ref": "#/$defs/Text"
        },
        {
          "$ref": "#/$defs/Image"
        },
        {
          "$ref": "#/$defs/Link"
        },
        {
          "$ref": "#/$defs/Input"
        },
        {
          "$ref": "#/$defs/Choice"
        },
        {
          "$ref": "#/$defs/Toggle"
        },
        {
          "$ref": "#/$defs/Slider"
        },
        {
          "$ref": "#/$defs/Form"
        },
        {
          "$ref": "#/$defs/Button"
        },
        {
          "$ref": "#/$defs/Tabs"
        },
        {
          "$ref": "#/$defs/Disclosure"
        },
        {
          "$ref": "#/$defs/Table"
        },
        {
          "$ref": "#/$defs/Chart"
        },
        {
          "$ref": "#/$defs/WebPreview"
        }
      ]
    },
    "VisibleWhen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bind",
        "op"
      ],
      "properties": {
        "bind": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "op": {
          "enum": [
            "equals",
            "notEquals",
            "in",
            "empty",
            "notEmpty"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "array"
          ],
          "maxItems": 100,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "Stack": {
      "type": "object",
      "description": "Arranges children vertically or horizontally.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "children"
      ],
      "properties": {
        "type": {
          "const": "Stack"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "direction": {
          "enum": [
            "vertical",
            "horizontal"
          ],
          "description": "Main axis.",
          "default": "vertical"
        },
        "gap": {
          "enum": [
            "none",
            "small",
            "medium",
            "large"
          ],
          "description": "Space between children.",
          "default": "medium"
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "description": "Cross axis alignment.",
          "default": "stretch"
        },
        "wrap": {
          "type": "boolean",
          "description": "Wrap horizontal children onto new lines.",
          "default": false
        },
        "children": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Component"
          },
          "description": "Child components."
        }
      }
    },
    "Grid": {
      "type": "object",
      "description": "Places children in equal columns that collapse to one column on narrow screens.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "columns",
        "children"
      ],
      "properties": {
        "type": {
          "const": "Grid"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "Column count on wide screens."
        },
        "gap": {
          "enum": [
            "none",
            "small",
            "medium",
            "large"
          ],
          "description": "Space between cells.",
          "default": "medium"
        },
        "children": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Component"
          },
          "description": "Grid cells."
        }
      }
    },
    "Card": {
      "type": "object",
      "description": "Groups related content under an optional title.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "children"
      ],
      "properties": {
        "type": {
          "const": "Card"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Card heading."
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Supporting text under the heading."
        },
        "children": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Component"
          },
          "description": "Card content."
        }
      }
    },
    "Divider": {
      "type": "object",
      "description": "A horizontal separator.",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "Divider"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        }
      }
    },
    "Text": {
      "type": "object",
      "description": "Plain text. Variants cover headings, body copy, captions and code. Markup is not interpreted.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "text"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "text": {
          "type": "string",
          "maxLength": 10000,
          "description": "Displayed text."
        },
        "variant": {
          "enum": [
            "heading1",
            "heading2",
            "heading3",
            "body",
            "caption",
            "code"
          ],
          "description": "Typographic role.",
          "default": "body"
        },
        "tone": {
          "enum": [
            "default",
            "muted",
            "success",
            "warning",
            "danger"
          ],
          "description": "Color emphasis.",
          "default": "default"
        }
      }
    },
    "Image": {
      "type": "object",
      "description": "An image from an allowed URL with a text alternative.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "src",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "Image"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "src": {
          "type": "string",
          "maxLength": 2048,
          "description": "Absolute image URL; host policy decides allowed schemes and origins."
        },
        "alt": {
          "type": "string",
          "maxLength": 500,
          "description": "Text alternative. Use an empty string only for purely decorative images."
        },
        "caption": {
          "type": "string",
          "maxLength": 500,
          "description": "Visible caption."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "description": "Intrinsic width in pixels, used to reserve space."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "description": "Intrinsic height in pixels."
        }
      }
    },
    "Link": {
      "type": "object",
      "description": "Navigates to a URL. Use Button for actions.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "href",
        "label"
      ],
      "properties": {
        "type": {
          "const": "Link"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "href": {
          "type": "string",
          "maxLength": 2048,
          "description": "Absolute URL; host policy decides allowed schemes, origins and target."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Link text."
        }
      }
    },
    "Input": {
      "type": "object",
      "description": "Single or multi line entry. kind selects the value type: number stores a number or null, every other kind stores a string.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "bind",
        "label"
      ],
      "properties": {
        "type": {
          "const": "Input"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "bind": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Field key in state.values."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Visible label."
        },
        "kind": {
          "enum": [
            "text",
            "email",
            "url",
            "tel",
            "number",
            "date",
            "time"
          ],
          "description": "Input kind; date is YYYY-MM-DD and time is HH:MM, both stored as strings.",
          "default": "text"
        },
        "multiline": {
          "type": "boolean",
          "description": "Multi line entry. Only for kind text.",
          "default": false
        },
        "placeholder": {
          "type": "string",
          "maxLength": 200,
          "description": "Example value shown when empty."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Help text."
        },
        "required": {
          "type": "boolean",
          "description": "Must be non empty to submit.",
          "default": false
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Minimum characters. Not for kind number."
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum characters. Not for kind number."
        },
        "min": {
          "type": "number",
          "description": "Minimum value. Only for kind number."
        },
        "max": {
          "type": "number",
          "description": "Maximum value. Only for kind number."
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Value granularity. Only for kind number."
        },
        "default": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "maxLength": 10000,
          "description": "Initial value when the user has none: a string, or a number or null for kind number."
        }
      }
    },
    "Choice": {
      "type": "object",
      "description": "Single or multiple selection from options. mode single stores a string (empty string when nothing is selected); mode multiple stores an array of strings.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "bind",
        "label",
        "mode",
        "options"
      ],
      "properties": {
        "type": {
          "const": "Choice"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "bind": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Field key in state.values."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Visible group label."
        },
        "mode": {
          "enum": [
            "single",
            "multiple"
          ],
          "description": "Selection mode."
        },
        "display": {
          "enum": [
            "buttons",
            "radio",
            "checkbox",
            "select"
          ],
          "description": "Presentation. radio is single only, checkbox is multiple only. Defaults to radio for single and checkbox for multiple."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            }
          },
          "description": "Options with unique values."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Help text."
        },
        "required": {
          "type": "boolean",
          "description": "Single: a value must be selected. Multiple: at least one, unless minSelected says otherwise.",
          "default": false
        },
        "minSelected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum selections. Only for mode multiple."
        },
        "maxSelected": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum selections. Only for mode multiple."
        },
        "default": {
          "type": [
            "string",
            "array"
          ],
          "maxLength": 200,
          "maxItems": 100,
          "items": {
            "type": "string"
          },
          "description": "Initial value: an option value for single, an array of option values for multiple."
        }
      }
    },
    "Toggle": {
      "type": "object",
      "description": "An on or off setting. Stores a boolean.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "bind",
        "label"
      ],
      "properties": {
        "type": {
          "const": "Toggle"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "bind": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Field key in state.values."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Visible label."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Help text."
        },
        "default": {
          "type": "boolean",
          "description": "Initial value.",
          "default": false
        }
      }
    },
    "Slider": {
      "type": "object",
      "description": "Selects a number in a bounded range. Stores a number.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "bind",
        "label",
        "min",
        "max"
      ],
      "properties": {
        "type": {
          "const": "Slider"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "bind": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Field key in state.values."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Visible label."
        },
        "min": {
          "type": "number",
          "description": "Lower bound."
        },
        "max": {
          "type": "number",
          "description": "Upper bound; greater than min."
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Increment; not larger than max - min.",
          "default": 1
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Help text."
        },
        "default": {
          "type": "number",
          "description": "Initial value within the bounds. Defaults to min."
        }
      }
    },
    "Form": {
      "type": "object",
      "description": "Submission scope. Submitting sends the values of the visible fields inside the form to submitAction. Forms cannot nest.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "submitAction",
        "children"
      ],
      "properties": {
        "type": {
          "const": "Form"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "submitAction": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$",
          "description": "Registered host action that receives the submitted values."
        },
        "children": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Component"
          },
          "description": "Fields and buttons."
        }
      }
    },
    "Button": {
      "type": "object",
      "description": "Runs an action. submit and reset act on the enclosing Form; action calls a registered host action without form values.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "label",
        "action"
      ],
      "properties": {
        "type": {
          "const": "Button"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Button text."
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "submit",
                "reset",
                "action"
              ]
            },
            "actionId": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "action"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "actionId"
            ]
          },
          "description": "{\"type\":\"submit\"}, {\"type\":\"reset\"} or {\"type\":\"action\",\"actionId\":\"<registered action>\"}."
        },
        "variant": {
          "enum": [
            "primary",
            "secondary",
            "danger"
          ],
          "description": "Emphasis. Defaults to primary for submit and secondary otherwise."
        }
      }
    },
    "Tabs": {
      "type": "object",
      "description": "Switches between panels locally. Tab switching never calls the host.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "tabs"
      ],
      "properties": {
        "type": {
          "const": "Tabs"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "label": {
          "type": "string",
          "maxLength": 200,
          "description": "Accessible name for the tab list."
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "children"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "children": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "$ref": "#/$defs/Component"
                }
              }
            }
          },
          "description": "Tabs with unique ids."
        },
        "defaultTab": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Initially active tab id. Defaults to the first tab."
        }
      }
    },
    "Disclosure": {
      "type": "object",
      "description": "Content that the user can expand and collapse locally.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "label",
        "children"
      ],
      "properties": {
        "type": {
          "const": "Disclosure"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Toggle text and accessible name."
        },
        "defaultOpen": {
          "type": "boolean",
          "description": "Initially expanded.",
          "default": false
        },
        "children": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Component"
          },
          "description": "Collapsible content."
        }
      }
    },
    "Table": {
      "type": "object",
      "description": "Shows rows from a dataset. Sorting is local.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "dataset",
        "columns"
      ],
      "properties": {
        "type": {
          "const": "Table"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "dataset": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Name of a dataset in the document's datasets."
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "label"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "format": {
                "enum": [
                  "text",
                  "number",
                  "date"
                ]
              }
            }
          },
          "description": "Columns with unique fields. format number requires numeric values or null."
        },
        "rowKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Field whose values identify rows uniquely."
        },
        "sortable": {
          "type": "boolean",
          "description": "Allow local sorting by column.",
          "default": false
        },
        "caption": {
          "type": "string",
          "maxLength": 200,
          "description": "Table caption."
        },
        "emptyText": {
          "type": "string",
          "maxLength": 200,
          "description": "Shown when the dataset has no rows."
        }
      }
    },
    "Chart": {
      "type": "object",
      "description": "Accessible SVG bar, line or pie chart from a dataset. Charts are local displays and never call the host.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "kind",
        "dataset",
        "x",
        "series",
        "title"
      ],
      "properties": {
        "type": {
          "const": "Chart"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "kind": {
          "enum": [
            "bar",
            "line",
            "pie"
          ],
          "description": "Grouped bars, lines with gaps for null values, or pie slices. Pie requires exactly one series and nonnegative values."
        },
        "dataset": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Name of a dataset in the document."
        },
        "x": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Category field. Every row must contain a string or finite number. Rows keep dataset order; line points are equally spaced."
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "label"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "description": "Unique numeric fields and their legend labels. Every mapped value must be a finite number or null. Null means missing, never zero."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Visible heading and accessible chart name."
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Optional explanation below the heading."
        },
        "height": {
          "type": "integer",
          "minimum": 200,
          "maximum": 600,
          "description": "Chart height in pixels; width adapts to the container.",
          "default": 300
        },
        "showLegend": {
          "type": "boolean",
          "description": "Show series labels, or category labels for pie slices. Full data remains available in the data table.",
          "default": true
        },
        "emptyText": {
          "type": "string",
          "maxLength": 200,
          "description": "Shown for empty or entirely null data, or a pie with no positive values."
        }
      }
    },
    "WebPreview": {
      "type": "object",
      "description": "Embeds an external page in a sandboxed frame with an open original link. Sites may refuse embedding; the link always remains.",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "url",
        "title"
      ],
      "properties": {
        "type": {
          "const": "WebPreview"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
        },
        "visibleWhen": {
          "$ref": "#/$defs/VisibleWhen"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "description": "Absolute URL; host policy decides allowed origins and sandbox."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Frame title and link text."
        },
        "height": {
          "type": "integer",
          "minimum": 200,
          "maximum": 1200,
          "description": "Frame height in pixels.",
          "default": 480
        }
      }
    }
  }
}
