{
  "$comment": "Source of truth for the component protocol. Schemas, types, validators, contract, instructions and the component reference are generated from this file by scripts/generate.mjs.",
  "protocolVersion": "1.0",
  "patterns": {
    "id": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
    "binding": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
    "action": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$",
    "dataset": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
  },
  "limits": {
    "maxBytes": 262144,
    "maxDepth": 16,
    "maxComponents": 500,
    "maxStringLength": 10000,
    "maxOptions": 100,
    "maxDatasets": 20,
    "maxDatasetRows": 1000,
    "maxDiagnostics": 100
  },
  "policy": {
    "urls": {
      "image": { "schemes": ["https"], "origins": ["*"] },
      "link": { "schemes": ["https", "http", "mailto"], "origins": ["*"] },
      "webPreview": { "schemes": ["https"], "origins": ["*"] }
    },
    "webPreview": { "sandbox": ["allow-scripts", "allow-forms", "allow-popups"] },
    "link": { "target": "blank" }
  },
  "visibleWhen": {
    "description": "Show the component only when a bound field matches. equals/notEquals take a scalar value, in takes an array, empty/notEmpty take no value.",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind", "op"],
      "properties": {
        "bind": { "type": "string", "pattern": "@binding" },
        "op": { "enum": ["equals", "notEquals", "in", "empty", "notEmpty"] },
        "value": { "type": ["string", "number", "boolean", "array"], "maxItems": 100, "items": { "type": ["string", "number", "boolean"] } }
      }
    }
  },
  "components": {
    "Stack": {
      "category": "layout",
      "description": "Arranges children vertically or horizontally.",
      "slots": ["children"],
      "props": {
        "direction": { "schema": { "enum": ["vertical", "horizontal"] }, "default": "vertical", "description": "Main axis." },
        "gap": { "schema": { "enum": ["none", "small", "medium", "large"] }, "default": "medium", "description": "Space between children." },
        "align": { "schema": { "enum": ["start", "center", "end", "stretch"] }, "default": "stretch", "description": "Cross axis alignment." },
        "wrap": { "schema": { "type": "boolean" }, "default": false, "description": "Wrap horizontal children onto new lines." },
        "children": { "schema": "@children", "required": true, "description": "Child components." }
      },
      "example": { "type": "Stack", "id": "actions", "direction": "horizontal", "children": [{ "type": "Text", "id": "hello", "text": "Hello" }] }
    },
    "Grid": {
      "category": "layout",
      "description": "Places children in equal columns that collapse to one column on narrow screens.",
      "slots": ["children"],
      "props": {
        "columns": { "schema": { "type": "integer", "minimum": 1, "maximum": 6 }, "required": true, "description": "Column count on wide screens." },
        "gap": { "schema": { "enum": ["none", "small", "medium", "large"] }, "default": "medium", "description": "Space between cells." },
        "children": { "schema": "@children", "required": true, "description": "Grid cells." }
      },
      "example": { "type": "Grid", "id": "stats", "columns": 2, "children": [{ "type": "Text", "id": "a", "text": "A" }, { "type": "Text", "id": "b", "text": "B" }] }
    },
    "Card": {
      "category": "layout",
      "description": "Groups related content under an optional title.",
      "slots": ["children"],
      "props": {
        "title": { "schema": { "type": "string", "maxLength": 200 }, "description": "Card heading." },
        "description": { "schema": { "type": "string", "maxLength": 2000 }, "description": "Supporting text under the heading." },
        "children": { "schema": "@children", "required": true, "description": "Card content." }
      },
      "example": { "type": "Card", "id": "summary", "title": "Summary", "children": [] }
    },
    "Divider": {
      "category": "layout",
      "description": "A horizontal separator.",
      "slots": [],
      "props": {},
      "example": { "type": "Divider", "id": "rule" }
    },
    "Text": {
      "category": "content",
      "description": "Plain text. Variants cover headings, body copy, captions and code. Markup is not interpreted.",
      "slots": [],
      "props": {
        "text": { "schema": { "type": "string", "maxLength": 10000 }, "required": true, "description": "Displayed text." },
        "variant": { "schema": { "enum": ["heading1", "heading2", "heading3", "body", "caption", "code"] }, "default": "body", "description": "Typographic role." },
        "tone": { "schema": { "enum": ["default", "muted", "success", "warning", "danger"] }, "default": "default", "description": "Color emphasis." }
      },
      "example": { "type": "Text", "id": "title", "text": "Trip plan", "variant": "heading2" }
    },
    "Image": {
      "category": "content",
      "description": "An image from an allowed URL with a text alternative.",
      "slots": [],
      "props": {
        "src": { "schema": { "type": "string", "maxLength": 2048 }, "required": true, "description": "Absolute image URL; host policy decides allowed schemes and origins." },
        "alt": { "schema": { "type": "string", "maxLength": 500 }, "required": true, "description": "Text alternative. Use an empty string only for purely decorative images." },
        "caption": { "schema": { "type": "string", "maxLength": 500 }, "description": "Visible caption." },
        "width": { "schema": { "type": "integer", "minimum": 1, "maximum": 4096 }, "description": "Intrinsic width in pixels, used to reserve space." },
        "height": { "schema": { "type": "integer", "minimum": 1, "maximum": 4096 }, "description": "Intrinsic height in pixels." }
      },
      "example": { "type": "Image", "id": "cover", "src": "https://example.com/berlin.jpg", "alt": "Brandenburg Gate at dusk" }
    },
    "Link": {
      "category": "content",
      "description": "Navigates to a URL. Use Button for actions.",
      "slots": [],
      "props": {
        "href": { "schema": { "type": "string", "maxLength": 2048 }, "required": true, "description": "Absolute URL; host policy decides allowed schemes, origins and target." },
        "label": { "schema": { "type": "string", "minLength": 1, "maxLength": 200 }, "required": true, "description": "Link text." }
      },
      "example": { "type": "Link", "id": "guide", "href": "https://example.com/guide", "label": "Travel guide" }
    },
    "Input": {
      "category": "input",
      "description": "Single or multi line entry. kind selects the value type: number stores a number or null, every other kind stores a string.",
      "slots": [],
      "binding": { "byProp": "kind", "map": { "number": "number", "*": "string" } },
      "props": {
        "bind": { "schema": { "type": "string", "pattern": "@binding" }, "required": true, "description": "Field key in state.values." },
        "label": { "schema": { "type": "string", "minLength": 1, "maxLength": 200 }, "required": true, "description": "Visible label." },
        "kind": { "schema": { "enum": ["text", "email", "url", "tel", "number", "date", "time"] }, "default": "text", "description": "Input kind; date is YYYY-MM-DD and time is HH:MM, both stored as strings." },
        "multiline": { "schema": { "type": "boolean" }, "default": false, "description": "Multi line entry. Only for kind text." },
        "placeholder": { "schema": { "type": "string", "maxLength": 200 }, "description": "Example value shown when empty." },
        "description": { "schema": { "type": "string", "maxLength": 1000 }, "description": "Help text." },
        "required": { "schema": { "type": "boolean" }, "default": false, "description": "Must be non empty to submit." },
        "minLength": { "schema": { "type": "integer", "minimum": 0, "maximum": 10000 }, "description": "Minimum characters. Not for kind number." },
        "maxLength": { "schema": { "type": "integer", "minimum": 1, "maximum": 10000 }, "description": "Maximum characters. Not for kind number." },
        "min": { "schema": { "type": "number" }, "description": "Minimum value. Only for kind number." },
        "max": { "schema": { "type": "number" }, "description": "Maximum value. Only for kind number." },
        "step": { "schema": { "type": "number", "exclusiveMinimum": 0 }, "description": "Value granularity. Only for kind number." },
        "default": { "schema": { "type": ["string", "number", "null"], "maxLength": 10000 }, "description": "Initial value when the user has none: a string, or a number or null for kind number." }
      },
      "example": { "type": "Input", "id": "name-input", "bind": "name", "label": "Your name", "required": true }
    },
    "Choice": {
      "category": "input",
      "description": "Single or multiple selection from options. mode single stores a string (empty string when nothing is selected); mode multiple stores an array of strings.",
      "slots": [],
      "binding": { "byProp": "mode", "map": { "single": "string", "multiple": "string[]" } },
      "props": {
        "bind": { "schema": { "type": "string", "pattern": "@binding" }, "required": true, "description": "Field key in state.values." },
        "label": { "schema": { "type": "string", "minLength": 1, "maxLength": 200 }, "required": true, "description": "Visible group label." },
        "mode": { "schema": { "enum": ["single", "multiple"] }, "required": true, "description": "Selection mode." },
        "display": { "schema": { "enum": ["buttons", "radio", "checkbox", "select"] }, "description": "Presentation. radio is single only, checkbox is multiple only. Defaults to radio for single and checkbox for multiple." },
        "options": {
          "schema": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["value", "label"],
              "properties": {
                "value": { "type": "string", "minLength": 1, "maxLength": 200 },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "description": { "type": "string", "maxLength": 500 }
              }
            }
          },
          "required": true, "description": "Options with unique values."
        },
        "description": { "schema": { "type": "string", "maxLength": 1000 }, "description": "Help text." },
        "required": { "schema": { "type": "boolean" }, "default": false, "description": "Single: a value must be selected. Multiple: at least one, unless minSelected says otherwise." },
        "minSelected": { "schema": { "type": "integer", "minimum": 0, "maximum": 100 }, "description": "Minimum selections. Only for mode multiple." },
        "maxSelected": { "schema": { "type": "integer", "minimum": 1, "maximum": 100 }, "description": "Maximum selections. Only for mode multiple." },
        "default": { "schema": { "type": ["string", "array"], "maxLength": 200, "maxItems": 100, "items": { "type": "string" } }, "description": "Initial value: an option value for single, an array of option values for multiple." }
      },
      "example": { "type": "Choice", "id": "destination-choice", "bind": "destination", "label": "Destination", "mode": "single", "display": "buttons", "options": [{ "value": "berlin", "label": "Berlin" }, { "value": "paris", "label": "Paris" }] }
    },
    "Toggle": {
      "category": "input",
      "description": "An on or off setting. Stores a boolean.",
      "slots": [],
      "binding": { "type": "boolean" },
      "props": {
        "bind": { "schema": { "type": "string", "pattern": "@binding" }, "required": true, "description": "Field key in state.values." },
        "label": { "schema": { "type": "string", "minLength": 1, "maxLength": 200 }, "required": true, "description": "Visible label." },
        "description": { "schema": { "type": "string", "maxLength": 1000 }, "description": "Help text." },
        "default": { "schema": { "type": "boolean" }, "default": false, "description": "Initial value." }
      },
      "example": { "type": "Toggle", "id": "notify-toggle", "bind": "notify", "label": "Email me updates" }
    },
    "Slider": {
      "category": "input",
      "description": "Selects a number in a bounded range. Stores a number.",
      "slots": [],
      "binding": { "type": "number" },
      "props": {
        "bind": { "schema": { "type": "string", "pattern": "@binding" }, "required": true, "description": "Field key in state.values." },
        "label": { "schema": { "type": "string", "minLength": 1, "maxLength": 200 }, "required": true, "description": "Visible label." },
        "min": { "schema": { "type": "number" }, "required": true, "description": "Lower bound." },
        "max": { "schema": { "type": "number" }, "required": true, "description": "Upper bound; greater than min." },
        "step": { "schema": { "type": "number", "exclusiveMinimum": 0 }, "default": 1, "description": "Increment; not larger than max - min." },
        "description": { "schema": { "type": "string", "maxLength": 1000 }, "description": "Help text." },
        "default": { "schema": { "type": "number" }, "description": "Initial value within the bounds. Defaults to min." }
      },
      "example": { "type": "Slider", "id": "budget-slider", "bind": "budget", "label": "Budget (EUR)", "min": 100, "max": 2000, "step": 50, "default": 800 }
    },
    "Form": {
      "category": "form",
      "description": "Submission scope. Submitting sends the values of the visible fields inside the form to submitAction. Forms cannot nest.",
      "slots": ["children"],
      "props": {
        "submitAction": { "schema": { "type": "string", "pattern": "@action" }, "required": true, "description": "Registered host action that receives the submitted values." },
        "children": { "schema": "@children", "required": true, "description": "Fields and buttons." }
      },
      "example": { "type": "Form", "id": "trip-form", "submitAction": "submit-plan", "children": [{ "type": "Button", "id": "submit-trip", "label": "Continue", "action": { "type": "submit" } }] }
    },
    "Button": {
      "category": "form",
      "description": "Runs an action. submit and reset act on the enclosing Form; action calls a registered host action without form values.",
      "slots": [],
      "props": {
        "label": { "schema": { "type": "string", "minLength": 1, "maxLength": 200 }, "required": true, "description": "Button text." },
        "action": {
          "schema": {
            "type": "object", "additionalProperties": false, "required": ["type"],
            "properties": {
              "type": { "enum": ["submit", "reset", "action"] },
              "actionId": { "type": "string", "pattern": "@action" }
            },
            "if": { "properties": { "type": { "const": "action" } }, "required": ["type"] },
            "then": { "required": ["actionId"] }
          },
          "required": true, "description": "{\"type\":\"submit\"}, {\"type\":\"reset\"} or {\"type\":\"action\",\"actionId\":\"<registered action>\"}."
        },
        "variant": { "schema": { "enum": ["primary", "secondary", "danger"] }, "description": "Emphasis. Defaults to primary for submit and secondary otherwise." }
      },
      "example": { "type": "Button", "id": "refresh", "label": "Refresh prices", "action": { "type": "action", "actionId": "refresh-prices" } }
    },
    "Tabs": {
      "category": "organization",
      "description": "Switches between panels locally. Tab switching never calls the host.",
      "slots": ["tabs/*/children"],
      "props": {
        "label": { "schema": { "type": "string", "maxLength": 200 }, "description": "Accessible name for the tab list." },
        "tabs": {
          "schema": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "label", "children"],
              "properties": {
                "id": { "type": "string", "pattern": "@id" },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "children": "@children"
              }
            }
          },
          "required": true, "description": "Tabs with unique ids."
        },
        "defaultTab": { "schema": { "type": "string", "pattern": "@id" }, "description": "Initially active tab id. Defaults to the first tab." }
      },
      "example": { "type": "Tabs", "id": "details-tabs", "tabs": [{ "id": "overview", "label": "Overview", "children": [] }, { "id": "costs", "label": "Costs", "children": [] }] }
    },
    "Disclosure": {
      "category": "organization",
      "description": "Content that the user can expand and collapse locally.",
      "slots": ["children"],
      "props": {
        "label": { "schema": { "type": "string", "minLength": 1, "maxLength": 200 }, "required": true, "description": "Toggle text and accessible name." },
        "defaultOpen": { "schema": { "type": "boolean" }, "default": false, "description": "Initially expanded." },
        "children": { "schema": "@children", "required": true, "description": "Collapsible content." }
      },
      "example": { "type": "Disclosure", "id": "more", "label": "More details", "children": [] }
    },
    "Table": {
      "category": "data",
      "description": "Shows rows from a dataset. Sorting is local.",
      "slots": [],
      "props": {
        "dataset": { "schema": { "type": "string", "pattern": "@dataset" }, "required": true, "description": "Name of a dataset in the document's datasets." },
        "columns": {
          "schema": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["field", "label"],
              "properties": {
                "field": { "type": "string", "minLength": 1, "maxLength": 64 },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "format": { "enum": ["text", "number", "date"] }
              }
            }
          },
          "required": true, "description": "Columns with unique fields. format number requires numeric values or null."
        },
        "rowKey": { "schema": { "type": "string", "minLength": 1, "maxLength": 64 }, "description": "Field whose values identify rows uniquely." },
        "sortable": { "schema": { "type": "boolean" }, "default": false, "description": "Allow local sorting by column." },
        "caption": { "schema": { "type": "string", "maxLength": 200 }, "description": "Table caption." },
        "emptyText": { "schema": { "type": "string", "maxLength": 200 }, "description": "Shown when the dataset has no rows." }
      },
      "example": { "type": "Table", "id": "hotel-table", "dataset": "hotels", "rowKey": "name", "columns": [{ "field": "name", "label": "Hotel" }, { "field": "price", "label": "Price", "format": "number" }] }
    },
    "Chart": {
      "category": "data",
      "description": "Accessible SVG bar, line or pie chart from a dataset. Charts are local displays and never call the host.",
      "slots": [],
      "props": {
        "kind": {
          "schema": {
            "enum": [
              "bar",
              "line",
              "pie"
            ]
          },
          "required": true,
          "description": "Grouped bars, lines with gaps for null values, or pie slices. Pie requires exactly one series and nonnegative values."
        },
        "dataset": {
          "schema": {
            "type": "string",
            "pattern": "@dataset"
          },
          "required": true,
          "description": "Name of a dataset in the document."
        },
        "x": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "required": true,
          "description": "Category field. Every row must contain a string or finite number. Rows keep dataset order; line points are equally spaced."
        },
        "series": {
          "schema": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "label"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          },
          "required": true,
          "description": "Unique numeric fields and their legend labels. Every mapped value must be a finite number or null. Null means missing, never zero."
        },
        "title": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "required": true,
          "description": "Visible heading and accessible chart name."
        },
        "description": {
          "schema": {
            "type": "string",
            "maxLength": 2000
          },
          "description": "Optional explanation below the heading."
        },
        "height": {
          "schema": {
            "type": "integer",
            "minimum": 200,
            "maximum": 600
          },
          "default": 300,
          "description": "Chart height in pixels; width adapts to the container."
        },
        "showLegend": {
          "schema": {
            "type": "boolean"
          },
          "default": true,
          "description": "Show series labels, or category labels for pie slices. Full data remains available in the data table."
        },
        "emptyText": {
          "schema": {
            "type": "string",
            "maxLength": 200
          },
          "description": "Shown for empty or entirely null data, or a pie with no positive values."
        }
      },
      "example": {
        "type": "Chart",
        "id": "sales-chart",
        "kind": "bar",
        "dataset": "sales",
        "x": "month",
        "series": [
          {
            "field": "revenue",
            "label": "Revenue"
          }
        ],
        "title": "Monthly revenue"
      }
    },
    "WebPreview": {
      "category": "external",
      "description": "Embeds an external page in a sandboxed frame with an open original link. Sites may refuse embedding; the link always remains.",
      "slots": [],
      "props": {
        "url": { "schema": { "type": "string", "maxLength": 2048 }, "required": true, "description": "Absolute URL; host policy decides allowed origins and sandbox." },
        "title": { "schema": { "type": "string", "minLength": 1, "maxLength": 200 }, "required": true, "description": "Frame title and link text." },
        "height": { "schema": { "type": "integer", "minimum": 200, "maximum": 1200 }, "default": 480, "description": "Frame height in pixels." }
      },
      "example": { "type": "WebPreview", "id": "map-preview", "url": "https://example.com/map", "title": "Route map" }
    }
  },
  "aliases": {
    "Row": { "type": "Stack", "set": { "direction": "horizontal" } },
    "HStack": { "type": "Stack", "set": { "direction": "horizontal" } },
    "Column": { "type": "Stack", "set": { "direction": "vertical" } },
    "VStack": { "type": "Stack", "set": { "direction": "vertical" } },
    "Container": { "type": "Stack" }, "Box": { "type": "Stack" }, "View": { "type": "Stack" }, "Section": { "type": "Card" }, "Panel": { "type": "Card" },
    "Heading": { "type": "Text", "set": { "variant": "heading2" } }, "Title": { "type": "Text", "set": { "variant": "heading1" } },
    "Paragraph": { "type": "Text", "set": { "variant": "body" } }, "Caption": { "type": "Text", "set": { "variant": "caption" } }, "CodeBlock": { "type": "Text", "set": { "variant": "code" } }, "Label": { "type": "Text" },
    "Img": { "type": "Image" }, "Picture": { "type": "Image" }, "Anchor": { "type": "Link" },
    "TextField": { "type": "Input" }, "TextInput": { "type": "Input" }, "Textarea": { "type": "Input", "set": { "multiline": true } }, "NumberInput": { "type": "Input", "set": { "kind": "number" } }, "DateInput": { "type": "Input", "set": { "kind": "date" } },
    "Select": { "type": "Choice", "set": { "mode": "single", "display": "select" } }, "Dropdown": { "type": "Choice", "set": { "mode": "single", "display": "select" } }, "RadioGroup": { "type": "Choice", "set": { "mode": "single", "display": "radio" } }, "CheckboxGroup": { "type": "Choice", "set": { "mode": "multiple", "display": "checkbox" } }, "MultiSelect": { "type": "Choice", "set": { "mode": "multiple", "display": "select" } },
    "Checkbox": { "type": "Toggle" }, "Switch": { "type": "Toggle" }, "Range": { "type": "Slider" },
    "Accordion": { "type": "Disclosure" }, "Collapse": { "type": "Disclosure" }, "Details": { "type": "Disclosure" },
    "DataTable": { "type": "Table" }, "Iframe": { "type": "WebPreview" }, "Embed": { "type": "WebPreview" },
    "Html": { "type": null }, "RawHtml": { "type": null }, "Markdown": { "type": null }, "Script": { "type": null }, "AppBlock": { "type": null }
  }
}
