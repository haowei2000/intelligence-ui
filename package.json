{
  "name": "intelligence-ui",
  "version": "0.2.0",
  "description": "Embeddable browser and React document renderer with state callbacks and pluggable write-back persistence",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./document": {
      "types": "./types/document.d.ts",
      "import": "./lib/document.mjs",
      "default": "./lib/document.mjs"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./browser/react.mjs",
      "default": "./browser/react.mjs"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "import": "./node.mjs",
      "default": "./node.mjs"
    }
  },
  "bin": {
    "intelligence-ui": "./bin/studio.mjs"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "node.mjs",
    "browser/",
    "types/",
    "lib/",
    "bin/",
    "public/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haowei2000/intelligence-ui.git"
  },
  "keywords": [
    "interactive-document",
    "ai",
    "code-review",
    "document-studio"
  ],
  "scripts": {
    "dev": "node --watch bin/studio.mjs",
    "start": "node bin/studio.mjs",
    "demo": "node examples/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check:types": "tsc -p tsconfig.types.json",
    "prepack": "npm run check:types && npm test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
