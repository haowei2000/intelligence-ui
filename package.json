{
  "name": "@haowei2000/intelligence-ui",
  "version": "0.3.0",
  "description": "Agent-generated interactive UI: a language independent component protocol, validation and Autofix, a browser and React runtime, and delivery, MCP and CLI tooling",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./document": {
      "types": "./types/document.d.ts",
      "import": "./lib/document.mjs",
      "default": "./lib/document.mjs"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./browser/react.mjs",
      "default": "./browser/react.mjs"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "import": "./node.mjs",
      "default": "./node.mjs"
    },
    "./protocol": {
      "types": "./types/protocol.d.ts",
      "import": "./protocol.mjs",
      "default": "./protocol.mjs"
    },
    "./protocol/*": "./protocol/*",
    "./agent": {
      "types": "./types/agent.d.ts",
      "import": "./agent.mjs",
      "default": "./agent.mjs"
    },
    "./runtime": {
      "types": "./types/runtime.d.ts",
      "import": "./runtime.mjs",
      "default": "./runtime.mjs"
    },
    "./runtime/react": {
      "types": "./types/runtime-react.d.ts",
      "import": "./lib/runtime/react.mjs",
      "default": "./lib/runtime/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "intelligence-ui": "bin/studio.mjs"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "node.mjs",
    "protocol.mjs",
    "agent.mjs",
    "runtime.mjs",
    "browser/",
    "types/",
    "lib/",
    "bin/",
    "public/",
    "protocol/",
    "playground/",
    "skill/",
    "docs/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haowei2000/intelligence-ui.git"
  },
  "keywords": [
    "interactive-ui",
    "generative-ui",
    "agent",
    "mcp",
    "json-schema",
    "react",
    "interactive-document"
  ],
  "scripts": {
    "dev": "node --watch bin/studio.mjs",
    "start": "node bin/studio.mjs",
    "demo": "node examples/server.mjs",
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "test": "node --test test/*.test.mjs",
    "check:types": "tsc -p tsconfig.types.json",
    "check:browser": "node scripts/browser-check.mjs",
    "check:browser:firefox": "node scripts/browser-check.mjs --browser firefox",
    "check:browser:safari": "node scripts/browser-check.mjs --browser safari",
    "prepack": "npm run check:generated && npm run check:types && npm test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "marked": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "homepage": "https://haowei2000.github.io/intelligence-ui/",
  "bugs": {
    "url": "https://github.com/haowei2000/intelligence-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
