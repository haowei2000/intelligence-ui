{
  "schemaVersion": "1.0",
  "title": "Sales overview",
  "root": {
    "type": "Stack",
    "id": "dashboard",
    "children": [
      {
        "type": "Chart",
        "id": "revenue-bars",
        "kind": "bar",
        "dataset": "sales",
        "x": "month",
        "series": [
          {
            "field": "revenue",
            "label": "Revenue"
          },
          {
            "field": "cost",
            "label": "Cost"
          }
        ],
        "title": "Revenue and cost",
        "description": "Monthly totals in EUR."
      },
      {
        "type": "Chart",
        "id": "revenue-line",
        "kind": "line",
        "dataset": "sales",
        "x": "month",
        "series": [
          {
            "field": "revenue",
            "label": "Revenue"
          },
          {
            "field": "cost",
            "label": "Cost"
          }
        ],
        "title": "Monthly trend",
        "description": "Missing cost data in March creates a gap."
      },
      {
        "type": "Chart",
        "id": "channel-pie",
        "kind": "pie",
        "dataset": "channels",
